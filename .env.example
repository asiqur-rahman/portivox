# ============================================================
# Portivox — Production Environment Configuration
# Copy this file to .env and fill in all values marked REPLACE_ME
# Never commit .env to version control.
# ============================================================

# ── Domain ──────────────────────────────────────────────────
# Root domain. Tunnels are served at {subdomain}.{ROOT_DOMAIN}
ROOT_DOMAIN=portivox.example.com

# Public base URL shown in access links and redirect URLs (no trailing slash).
# Must match what browsers/clients resolve to (include https:// in production).
GATEWAY_PUBLIC_BASE_URL=https://portivox.example.com

# ── Auth ────────────────────────────────────────────────────
# Set to true in production — requires AUTH_JWT_SECRET below.
AUTH_REQUIRED=true

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_JWT_SECRET=REPLACE_ME_64_CHAR_HEX

# ── Database ─────────────────────────────────────────────────
# Choose one provider: postgresql | mysql
DB_PROVIDER=postgresql

# PostgreSQL credentials — used by the postgres service AND DATABASE_URL below.
POSTGRES_DB=portivox
POSTGRES_USER=portivox
POSTGRES_PASSWORD=REPLACE_ME_STRONG_PASSWORD

# Full connection string — must match POSTGRES_USER / PASSWORD / DB above.
# When running via docker-compose the host is "postgres" (the service name).
DATABASE_URL=postgresql://portivox:REPLACE_ME_STRONG_PASSWORD@postgres:5432/portivox?schema=public

# MySQL alternative:
# DB_PROVIDER=mysql
# DATABASE_URL=mysql://portivox:REPLACE_ME_STRONG_PASSWORD@mysql:3306/portivox

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the management API.
CORS_ALLOWED_ORIGINS=https://portivox.example.com

# ── TCP Tunnels ──────────────────────────────────────────────
TCP_PUBLIC_HOST=portivox.example.com
TCP_PUBLIC_PORT_START=19000
TCP_PUBLIC_PORT_END=19099

# TCP ports are dark by default — caller must click the access link first (true/false).
IP_PROTECTION_DEFAULT=true

# Max new TCP connections per IP per minute (defends against port scanners).
TCP_CONNECTION_RATE_LIMIT=10

# ── Optional tuning ──────────────────────────────────────────
# Uncomment and adjust as needed. Defaults are shown.

# TUNNEL_RESPONSE_TIMEOUT_MS=20000
# WS_IDLE_TIMEOUT_MS=30000
# REGISTRY_LEASE_TTL_MS=30000
# API_RATE_LIMIT_READ_PER_MIN=600
# API_RATE_LIMIT_WRITE_PER_MIN=300
# HEARTBEAT_INTERVAL_MS=5000
# MAX_CONCURRENT_STREAMS_PER_TUNNEL=200

# ── Audit export (optional) ───────────────────────────────────
# Export audit events to a local JSONL file, a webhook, or both.

# AUDIT_EXPORT_JSONL_PATH=/var/log/portivox/audit.jsonl
# AUDIT_EXPORT_WEBHOOK_URL=https://your-siem.example.com/events
# AUDIT_EXPORT_WEBHOOK_SECRET=REPLACE_ME_HMAC_SECRET
# AUDIT_EXPORT_WEBHOOK_TIMEOUT_MS=3000
# AUDIT_EXPORT_DEAD_LETTER_JSONL_PATH=/var/log/portivox/audit-dead-letter.jsonl
