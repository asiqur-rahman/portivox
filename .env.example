# ============================================================
# Portivox — Environment Configuration
# Copy this file to .env and fill in the REQUIRED values.
# Never commit .env to version control.
# ============================================================

# ── Nginx port ───────────────────────────────────────────────
# Host port nginx listens on. Change to e.g. 8080 if port 80 is taken.
NGINX_PORT=80

# ── Auth ─────────────────────────────────────────────────────
AUTH_REQUIRED=true

# REQUIRED — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_JWT_SECRET=REPLACE_ME_STRONG_SECRET

# ── Gateway public URL ────────────────────────────────────────
# REQUIRED — base URL used in access links and redirect URLs (no trailing slash)
GATEWAY_PUBLIC_BASE_URL=https://portivox.braintechsolution.com

# ── CORS ─────────────────────────────────────────────────────
# REQUIRED — comma-separated origins allowed to call the management API
CORS_ALLOWED_ORIGINS=https://portivox.braintechsolution.com

# ── Database ──────────────────────────────────────────────────
DB_PROVIDER=postgresql

# POSTGRES_PASSWORD is required separately because the postgres Docker container
# needs it to initialise — it cannot read DATABASE_URL itself.
# POSTGRES_DB and POSTGRES_USER default to "portivox" in docker-compose.yml.
POSTGRES_PASSWORD=REPLACE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql://portivox:REPLACE_ME_STRONG_PASSWORD@postgres:5432/portivox?schema=public

# MySQL alternative (no separate password var needed — Docker not managed here):
# DB_PROVIDER=mysql
# DATABASE_URL=mysql://portivox:REPLACE_ME_STRONG_PASSWORD@mysql:3306/portivox

# ── TCP Tunnels ───────────────────────────────────────────────
TCP_PUBLIC_HOST=portivox.braintechsolution.com
TCP_PUBLIC_PORT_START=19000
TCP_PUBLIC_PORT_END=19099

# TCP ports are dark until caller clicks the access link (true/false)
IP_PROTECTION_DEFAULT=true

# Max new TCP connections per IP per minute
TCP_CONNECTION_RATE_LIMIT=10

# ── Optional tuning ───────────────────────────────────────────
# TUNNEL_RESPONSE_TIMEOUT_MS=20000
# WS_IDLE_TIMEOUT_MS=30000
# REGISTRY_LEASE_TTL_MS=30000
# API_RATE_LIMIT_READ_PER_MIN=600
# API_RATE_LIMIT_WRITE_PER_MIN=300
# HEARTBEAT_INTERVAL_MS=5000

# ── Audit export (optional) ───────────────────────────────────
# AUDIT_EXPORT_JSONL_PATH=/var/log/portivox/audit.jsonl
# AUDIT_EXPORT_WEBHOOK_URL=https://your-siem.example.com/events
# AUDIT_EXPORT_WEBHOOK_SECRET=REPLACE_ME_HMAC_SECRET
# AUDIT_EXPORT_WEBHOOK_TIMEOUT_MS=3000
# AUDIT_EXPORT_DEAD_LETTER_JSONL_PATH=/var/log/portivox/audit-dead-letter.jsonl
