# ============================================================
# Portivox — Environment Configuration
# ============================================================
#  1. Copy this file:  cp .env.example .env
#  2. Fill in every value marked REQUIRED
#  3. Never commit .env to version control — it is gitignored
# ============================================================

# ── Nginx ────────────────────────────────────────────────────
# Host port nginx listens on.
# Change to e.g. 8080 if port 80 is already in use.
NGINX_PORT=80

# ── Auth ─────────────────────────────────────────────────────
# Set to false only for local development — always keep true in production.
AUTH_REQUIRED=true

# REQUIRED — 256-bit random secret used to sign and verify JWTs.
# Generate a new one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_JWT_SECRET=REPLACE_ME_STRONG_SECRET

# ── Public URL ───────────────────────────────────────────────
# REQUIRED for production — The base URL of your gateway as seen by EXTERNAL
# USERS on the internet.  No trailing slash.
#
# ┌─ IMPORTANT: two separate URL spaces ───────────────────────────────────────┐
# │  GATEWAY_PUBLIC_BASE_URL   →  public data-plane URL returned to clients   │
# │                               (appears in redirect links / access links)   │
# │  --gateway ws://...        →  internal control-plane URL the tunnel CLI   │
# │                               uses to connect (can be localhost or LAN)    │
# │                                                                             │
# │  It is NORMAL and CORRECT for the gateway connection URL to be             │
# │  ws://localhost/connect while the public redirect URL uses your domain.    │
# │  The tunnel client connects internally; external users reach the tunnel    │
# │  through the public domain.                                                 │
# └─────────────────────────────────────────────────────────────────────────────┘
#
# For local development (no public access):
#   GATEWAY_PUBLIC_BASE_URL=http://localhost
# For production:
#   GATEWAY_PUBLIC_BASE_URL=https://your-domain.com
GATEWAY_PUBLIC_BASE_URL=https://portivox.braintechsolution.com

# ── CORS ─────────────────────────────────────────────────────
# REQUIRED — Comma-separated list of origins allowed to call the management API.
# For a single-domain deployment this is usually the same as GATEWAY_PUBLIC_BASE_URL.
CORS_ALLOWED_ORIGINS=https://portivox.braintechsolution.com

# ── Database ─────────────────────────────────────────────────
# REQUIRED — Choose ONE database engine, uncomment the matching block,
#            and leave the other block commented out.
#
# DB_PROVIDER is a Docker build-arg that selects the Prisma schema at image
# build time; DATABASE_URL is the runtime connection string passed to the
# container.  Both values must refer to the same engine.
#
# ┌─ Option A: MySQL 8 (default) ──────────────────────────────┐
DB_PROVIDER=mysql
DATABASE_URL=mysql://portivox:REPLACE_ME_STRONG_PASSWORD@mysql:3306/portivox
# └────────────────────────────────────────────────────────────┘
#
# ┌─ Option B: PostgreSQL 15 ──────────────────────────────────┐
# DB_PROVIDER=postgresql
# DATABASE_URL=postgresql://portivox:REPLACE_ME_STRONG_PASSWORD@postgres:5432/portivox
# └────────────────────────────────────────────────────────────┘
#
# If you are running the database inside Docker, also set the container
# credentials below (they must match the password in DATABASE_URL above):
#
#   MySQL
#   MYSQL_ROOT_PASSWORD=REPLACE_ME_ROOT_PASSWORD
#   MYSQL_PASSWORD=REPLACE_ME_STRONG_PASSWORD
#
#   PostgreSQL
#   POSTGRES_PASSWORD=REPLACE_ME_STRONG_PASSWORD

# ── TCP Tunnels ───────────────────────────────────────────────
# Default HTTP tunnels and TCP tunnels are exposed as:
#   portivox.braintechsolution.com:<allocated-port>
#
# Premium/custom subdomain tunnels are available with:
#   portivox open 3000 --subdomain myapp
# but authenticated production users need the tunnel:subdomain scope.
HTTP_PUBLIC_PORT_MODE=true

# Publicly reachable hostname that clients connect to for public-port tunnels.
# Usually the same domain as GATEWAY_PUBLIC_BASE_URL (without the scheme).
TCP_PUBLIC_HOST=portivox.braintechsolution.com

# Range of host ports the gateway binds for default HTTP public-port tunnels
# and TCP tunnel sessions.
# Make sure this range is open in your firewall / cloud security group.
TCP_PUBLIC_PORT_START=19000
TCP_PUBLIC_PORT_END=19099

# Keep TCP ports dark (blocked) until the caller visits the one-time access link.
# Set to false to open ports immediately on tunnel creation.
IP_PROTECTION_DEFAULT=true

# Maximum new TCP connections allowed per source IP per minute (anti-abuse).
TCP_CONNECTION_RATE_LIMIT=10

# ── Metrics ──────────────────────────────────────────────────
# When set, GET /metrics requires  Authorization: Bearer <token>.
# Nginx additionally restricts /metrics to RFC-1918 ranges; this adds a
# second, application-level layer of protection.
# METRICS_TOKEN=REPLACE_ME_METRICS_TOKEN

# ── Optional tuning ──────────────────────────────────────────
# Sensible defaults are built in.  Uncomment and adjust only what you need.
#
# Maximum time (ms) the gateway waits for the tunnel client to respond.
# TUNNEL_RESPONSE_TIMEOUT_MS=20000
#
# Maximum idle time (ms) before an inactive WebSocket connection is closed.
# WS_IDLE_TIMEOUT_MS=30000
#
# How long (ms) a tunnel registration lease stays valid in Redis.
# REGISTRY_LEASE_TTL_MS=30000
#
# API rate limits — requests per IP per minute.
# API_RATE_LIMIT_READ_PER_MIN=600
# API_RATE_LIMIT_WRITE_PER_MIN=300
#
# Interval (ms) at which the tunnel client sends keep-alive heartbeats.
# HEARTBEAT_INTERVAL_MS=5000

# ── Audit export (optional) ──────────────────────────────────
# Stream every audit event to a JSONL file, a SIEM webhook, or both.
# All settings in this section are optional and independent of each other.
#
# Append audit events as newline-delimited JSON to a local file.
# AUDIT_EXPORT_JSONL_PATH=/var/log/portivox/audit.jsonl
#
# POST each audit event to an external webhook (HTTPS only).
# AUDIT_EXPORT_WEBHOOK_URL=https://your-siem.example.com/events
#
# HMAC-SHA256 secret used to sign webhook payloads (X-Portivox-Signature header).
# AUDIT_EXPORT_WEBHOOK_SECRET=REPLACE_ME_HMAC_SECRET
#
# Webhook request timeout in milliseconds.
# AUDIT_EXPORT_WEBHOOK_TIMEOUT_MS=3000
#
# Failed webhook deliveries are written here so nothing is silently dropped.
# AUDIT_EXPORT_DEAD_LETTER_JSONL_PATH=/var/log/portivox/audit-dead-letter.jsonl
