# Base domain
ROOT_DOMAIN=portivox.braintechsolution.com

# Optional auth controls
AUTH_REQUIRED=true
AUTH_JWT_SECRET=replace-with-strong-secret-at-least-32-chars

# Gateway local ports
GATEWAY_PORT=8080
GATEWAY_WS_PORT=7000

# Registry backend
REGISTRY_BACKEND=redis
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=portivox:registry
REGISTRY_LEASE_TTL_MS=30000

# Database (single source)
DATABASE_URL=postgresql://postgres:replace-with-strong-password@localhost:5432/portivox?schema=public&sslmode=disable

# TCP tunnel public range
TCP_TUNNEL_ENABLED=true
TCP_PUBLIC_HOST=portivox.braintechsolution.com
TCP_PUBLIC_PORT_START=19000
TCP_PUBLIC_PORT_END=19999

# Frontend/browser integration
CORS_ALLOWED_ORIGINS=https://portivox.braintechsolution.com
