# Production root domain
ROOT_DOMAIN=portivox.braintechsolution.com

# Public TCP endpoint host for SSH/RDP tunnel clients
TCP_PUBLIC_HOST=portivox.braintechsolution.com
TCP_PUBLIC_PORT_START=19000
TCP_PUBLIC_PORT_END=19999

# CORS allowlist for frontend/admin
CORS_ALLOWED_ORIGINS=https://portivox.braintechsolution.com

# Auth secrets
AUTH_JWT_SECRET=replace-with-strong-secret-at-least-32-chars

# Database (single app setting)
# Choose one provider: postgresql | mysql
DB_PROVIDER=postgresql
# Set DATABASE_URL to match DB_PROVIDER
DATABASE_URL=postgresql://postgres:replace-with-strong-password@postgres:5432/portivox?schema=public&sslmode=disable
# MySQL example:
# DATABASE_URL=mysql://root:replace-with-strong-password@mysql:3306/portivox
