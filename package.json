{
  "name": "portivox-platform",
  "private": true,
  "version": "0.1.0",
  "author": "Md. Asiqur Rahman Khan <https://github.com/asiqur-rahman>",
  "license": "MIT",
  "bin": {
    "portivox": "apps/tunnel-client/dist/index.js"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run -w apps/gateway-server build && npm run -w apps/tunnel-client build && npm run -w apps/frontend build && npm run -w packages/portivox-client build",
    "openapi:export": "npm run -w apps/gateway-server build && node ./scripts/export-openapi.cjs",
    "openapi:check-sdk-compat": "node ./scripts/check-sdk-openapi-compat.cjs",
    "typecheck": "npm run build",
    "test:smoke": "node ./scripts/smoke-e2e.cjs",
    "test:smoke:tcp": "node ./scripts/smoke-tcp-e2e.cjs",
    "test:smoke:docker": "node ./scripts/smoke-docker-e2e.cjs",
    "test:chunk": "node ./scripts/test-chunk-e2e.cjs",
    "test:auth": "node ./scripts/test-auth-integration.cjs",
    "test:audit-replay": "node ./scripts/test-audit-replay.cjs",
    "test:api-contract": "node ./scripts/test-api-contract.cjs",
    "test:rate-limit-contract": "node ./scripts/test-rate-limit-contract.cjs",
    "test:security-cors-contract": "node ./scripts/test-security-cors-contract.cjs",
    "test:payload-validation-contract": "node ./scripts/test-payload-validation-contract.cjs",
    "test:idempotency-contract": "node ./scripts/test-idempotency-contract.cjs",
    "test:audit-query-contract": "node ./scripts/test-audit-query-contract.cjs",
    "test:sdk": "node ./scripts/test-sdk-integration.cjs",
    "test:redis-registry": "node ./scripts/test-registry-redis.cjs",
    "drill:health": "node ./scripts/drills/health-readiness-check.cjs",
    "drill:drain": "node ./scripts/drills/drain-cycle.cjs",
    "audit:replay-dead-letter": "node ./scripts/replay-dead-letter-audit.cjs",
    "db:generate": "node ./scripts/prisma-runner.cjs generate",
    "db:generate:postgresql": "node ./scripts/prisma-runner.cjs --provider=postgresql generate",
    "db:generate:mysql": "node ./scripts/prisma-runner.cjs --provider=mysql generate",
    "db:migrate": "node ./scripts/prisma-runner.cjs migrate dev",
    "db:migrate:postgresql": "node ./scripts/prisma-runner.cjs --provider=postgresql migrate dev",
    "db:migrate:mysql": "node ./scripts/prisma-runner.cjs --provider=mysql migrate dev",
    "db:migrate:deploy": "node ./scripts/prisma-runner.cjs migrate deploy",
    "db:migrate:deploy:postgresql": "node ./scripts/prisma-runner.cjs --provider=postgresql migrate deploy",
    "db:migrate:deploy:mysql": "node ./scripts/prisma-runner.cjs --provider=mysql migrate deploy",
    "db:studio": "node ./scripts/prisma-runner.cjs studio",
    "dev:gateway": "npm run -w apps/gateway-server dev",
    "dev:client": "npm run -w apps/tunnel-client dev --",
    "dev:client:package": "npm run -w packages/portivox-client dev --",
    "dev:frontend": "npm run -w apps/frontend dev",
    "portivox:register": "npm run -w apps/tunnel-client dev -- register",
    "portivox:open": "npm run -w apps/tunnel-client dev -- open",
    "client:build": "npm run -w packages/portivox-client build",
    "client:pack": "npm pack --workspace packages/portivox-client",
    "client:version:patch": "npm version patch --workspace packages/portivox-client",
    "client:version:minor": "npm version minor --workspace packages/portivox-client",
    "client:version:major": "npm version major --workspace packages/portivox-client",
    "docker:dev:up": "docker compose up -d --build",
    "docker:dev:down": "docker compose down --remove-orphans",
    "docker:dev:logs": "docker compose logs -f",
    "docker:prod:up": "docker compose up -d --build",
    "docker:prod:down": "docker compose down --remove-orphans",
    "docker:prod:logs": "docker compose logs -f",
    "start:gateway:win": "scripts\\start-gateway.cmd",
    "start:client:win": "scripts\\start-client.cmd",
    "start:gateway:linux": "bash ./scripts/start-gateway.sh",
    "deploy": "bash ./scripts/deploy.sh",
    "deploy:docker": "bash ./scripts/deploy.sh --docker",
    "deploy:docker:mysql": "bash ./scripts/deploy.sh --docker --with-mysql",
    "start:client:linux": "bash ./scripts/start-client.sh",
    "portivox": "node ./scripts/portivox-cli.cjs"
  },
  "devDependencies": {
    "@prisma/client": "^6.8.2",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^6.8.2"
  }
}

