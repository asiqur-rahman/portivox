{
  "name": "portivox-platform",
  "private": true,
  "version": "0.1.0",
  "author": "Md. Asiqur Rahman Khan <https://github.com/asiqur-rahman>",
  "license": "MIT",
  "bin": {
    "portivox": "apps/tunnel-client/dist/index.js"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run -w apps/gateway-server build && npm run -w apps/tunnel-client build && npm run -w apps/frontend build && npm run -w packages/portivox-client build",
    "typecheck": "tsc -p apps/gateway-server/tsconfig.json --noEmit && tsc -p apps/tunnel-client/tsconfig.json --noEmit && tsc -p packages/portivox-client/tsconfig.json --noEmit",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "openapi:export": "npm run -w apps/gateway-server build && node ./scripts/export-openapi.cjs",
    "openapi:check-sdk-compat": "node ./scripts/check-sdk-openapi-compat.cjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "test:ci": "npm run build && npm run openapi:export && npm run openapi:check-sdk-compat && npm run test:smoke && npm run test:smoke:tcp && npm run test:smoke:dedicated-port && npm run test:subdomain-entitlement && npm run test:admin-tunnel-control && npm run test:chunk && npm run test:audit-replay && npm run test:api-contract && npm run test:rate-limit-contract && npm run test:security-cors-contract && npm run test:payload-validation-contract && npm run test:idempotency-contract && npm run test:audit-query-contract && npm run test:sdk && npm run test:auth && npm run test:cli-revoke && npm run test:fixed-tcp-revoke",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "test:e2e:visual": "playwright test tests/e2e/visual.spec.ts",
    "test:e2e:update-snapshots": "playwright test tests/e2e/visual.spec.ts --update-snapshots",
    "test:smoke": "node ./scripts/smoke-e2e.cjs",
    "test:smoke:tcp": "node ./scripts/smoke-tcp-e2e.cjs",
    "test:smoke:dedicated-port": "node ./scripts/smoke-http-dedicated-port-e2e.cjs",
    "test:subdomain-entitlement": "node ./scripts/test-subdomain-entitlement.cjs",
    "test:admin-tunnel-control": "node ./scripts/test-admin-tunnel-control.cjs",
    "test:smoke:docker": "node ./scripts/smoke-docker-e2e.cjs",
    "test:multinode:docker": "node ./scripts/test-multinode-failover-docker.cjs",
    "test:chunk": "node ./scripts/test-chunk-e2e.cjs",
    "test:auth": "node ./scripts/test-auth-integration.cjs",
    "test:audit-replay": "node ./scripts/test-audit-replay.cjs",
    "test:api-contract": "node ./scripts/test-api-contract.cjs",
    "test:rate-limit-contract": "node ./scripts/test-rate-limit-contract.cjs",
    "test:security-cors-contract": "node ./scripts/test-security-cors-contract.cjs",
    "test:payload-validation-contract": "node ./scripts/test-payload-validation-contract.cjs",
    "test:idempotency-contract": "node ./scripts/test-idempotency-contract.cjs",
    "test:audit-query-contract": "node ./scripts/test-audit-query-contract.cjs",
    "test:sdk": "node ./scripts/test-sdk-integration.cjs",
    "test:cli-revoke": "node ./scripts/test-cli-visibility-revoke.cjs",
    "test:fixed-tcp-revoke": "node ./scripts/test-fixed-port-tcp-revoke.cjs",
    "test:redis-registry": "node ./scripts/test-registry-redis.cjs",
    "drill:health": "node ./scripts/drills/health-readiness-check.cjs",
    "drill:drain": "node ./scripts/drills/drain-cycle.cjs",
    "audit:replay-dead-letter": "node ./scripts/replay-dead-letter-audit.cjs",
    "db:generate": "node ./scripts/prisma-runner.cjs generate",
    "db:migrate": "node ./scripts/prisma-runner.cjs migrate dev",
    "db:migrate:deploy": "node ./scripts/prisma-runner.cjs migrate deploy",
    "db:studio": "node ./scripts/prisma-runner.cjs studio",
    "dev:gateway": "npm run -w apps/gateway-server dev",
    "dev:client": "npm run -w apps/tunnel-client dev --",
    "dev:client:package": "npm run -w packages/portivox-client dev --",
    "dev:frontend": "npm run -w apps/frontend dev",
    "client:build": "npm run -w packages/portivox-client build",
    "client:pack": "npm pack --workspace packages/portivox-client",
    "docker:up": "docker compose up -d --build",
    "docker:rebuild": "docker compose build --no-cache && docker compose up -d --force-recreate",
    "docker:down": "docker compose down --remove-orphans",
    "docker:down:v": "docker compose down --remove-orphans --volumes",
    "docker:logs": "docker compose logs -f",
    "docker:migrate": "docker compose run --rm gateway node scripts/prisma-runner.cjs migrate deploy",
    "docker:ps": "docker compose ps",
    "deploy": "bash ./scripts/deploy.sh",
    "deploy:docker": "bash ./scripts/deploy.sh --docker",
    "portivox": "node ./scripts/portivox-cli.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@prisma/client": "^6.8.2",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^6.8.2"
  }
}
