{
  "name": "portivox-client",
  "version": "0.2.2",
  "description": "Portivox client CLI for exposing local ports through Portivox gateway",
  "author": "Md. Asiqur Rahman Khan <https://github.com/asiqur-rahman>",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "bin": {
    "portivox": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=14.14.0"
  },
  "keywords": [
    "tunnel",
    "port-forward",
    "ssh",
    "rdp",
    "portivox"
  ],
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
